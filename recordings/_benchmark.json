  "issues": {
    "pr_001_auth_bypass": [
      {
        "id": "auth",
        "description": "violates mandatory Depends(get_current_user) authentication pattern"
      },
      {
        "id": "errors",
        "description": "missing try/except with logging around the database write, unlike other write endpoints"
      }
    ],
    "pr_002_sql_injection": [
      {
        "id": "sqli",
        "description": "SQL injection: user input interpolated into the query"
      },
      {
        "id": "auth",
        "description": "search endpoint has no Depends(get_current_user)"
      }
    ],
    "pr_003_hardcoded_secret": [
      {
        "id": "secret",
        "description": "hardcoded live API key in source"
      },
      {
        "id": "env",
        "description": "violates environment variable pattern for secrets (app.config.settings)"
      }
    ],
    "pr_004_missing_error_handling": [
      {
        "id": "leak",
        "description": "returns raw exception text to the client instead of a generic 500"
      },
      {
        "id": "notfound",
        "description": "fetchone() can return None for a missing/other user's order and the error is swallowed as a 200"
      }
    ],
    "pr_005_race_condition": [
      {
        "id": "lock",
        "description": "violates mandatory FOR UPDATE locking pattern for inventory (race condition)"
      },
      {
        "id": "qty",
        "description": "quantity is not validated as positive, so a negative quantity increases stock"
      }
    ],
    "pr_006_xss_vulnerability": [
      {
        "id": "xss",
        "description": "unescaped user input rendered as HTML (XSS)"
      },
      {
        "id": "bio",
        "description": "bio comes from a query parameter instead of the stored profile, so anyone can craft a page"
      }
    ],
    "pr_007_weak_crypto": [
      {
        "id": "random",
        "description": "violates secrets module requirement for tokens (random is predictable)"
      },
      {
        "id": "md5",
        "description": "MD5 used for password hashing instead of hash_password (PBKDF2)"
      }
    ],
    "pr_008_missing_rate_limit": [
      {
        "id": "ratelimit",
        "description": "auth endpoint missing @rate_limit, so 6-digit codes can be brute-forced"
      },
      {
        "id": "expiry",
        "description": "code expiry (5 minutes) is never checked"
      }
    ],
    "pr_009_insecure_deserialization": [
      {
        "id": "pickle",
        "description": "pickle.loads on untrusted input allows remote code execution"
      },
      {
        "id": "size",
        "description": "no limit on the uploaded body size (settings.MAX_UPLOAD_BYTES)"
      }
    ],
    "pr_010_missing_input_validation": [
      {
        "id": "age",
        "description": "age has no bounds (UserProfile requires 13-130)"
      },
      {
        "id": "email",
        "description": "email is a plain str, not validated as an email (EmailStr)"
      }
    ],
    "pr_011_info_disclosure": [
      {
        "id": "trace",
        "description": "stack traces and exception text returned to clients"
      },
      {
        "id": "hash",
        "description": "password hash included in the export response (use UserPublic)"
      }
    ],
    "pr_012_path_traversal": [
      {
        "id": "traversal",
        "description": "path traversal: user path not passed through safe_join"
      },
      {
        "id": "auth",
        "description": "invoice download has no Depends(get_current_user)"
      }
    ],
    "pr_013_cors_misconfiguration": [
      {
        "id": "wildcard",
        "description": "wildcard CORS origin instead of settings.ALLOWED_ORIGINS / the partner origin"
      },
      {
        "id": "creds",
        "description": "credentials allowed together with a wildcard origin"
      }
    ],
    "pr_014_timing_attack": [
      {
        "id": "timing",
        "description": "secret compared with == instead of secrets.compare_digest (timing attack)"
      },
      {
        "id": "logged",
        "description": "API key written to logs"
      }
    ],
    "pr_015_unvalidated_redirect": [
      {
        "id": "redirect",
        "description": "open redirect: `next` not checked with is_safe_redirect"
      },
      {
        "id": "token",
        "description": "login token is never verified before being set as the session"
      }
    ]
