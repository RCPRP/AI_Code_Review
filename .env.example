# Copy to .env and fill in. Never commit .env.

# Gemini (preferred): used for the LLM and the embeddings
GOOGLE_API_KEY=
# Or Gemini through Vertex AI with gcloud credentials instead of an API key:
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Fallbacks if there's no Google key
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: LangSmith tracing
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=code-review-agent

# Optional overrides
# REVIEW_MODEL=google_genai:gemini-3.8-flash
# REVIEW_MODE=auto   # auto | live | replay
